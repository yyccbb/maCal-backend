NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://macal:macal_password@localhost:5432/macal?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

CORS_ORIGIN=http://localhost:3000,http://localhost:5173
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=10
AI_THROTTLE_TTL_MS=60000
AI_THROTTLE_LIMIT=30

DEFAULT_LOCALE=en
DEFAULT_TIMEZONE=Asia/Shanghai
LLM_PROVIDER=placeholder
SMS_PROVIDER=placeholder
OBJECT_STORAGE_PROVIDER=placeholder
